---
const features = [
  {
    title: 'Remote toggles',
    description: 'Turn features on or off from the dashboard. No code deploy required. Change behavior in seconds.',
    icon: '🔀',
  },
  {
    title: 'Percentage rollouts',
    description: 'Release to 5%, 25%, or 100% of users. Gradual rollouts reduce risk and catch issues early.',
    icon: '📊',
  },
  {
    title: 'A/B testing',
    description: 'Run experiments and compare variants. Data-driven decisions with built-in metrics and segments.',
    icon: '🧪',
  },
  {
    title: 'Multi-environment',
    description: 'Separate dev, staging, and production. Each environment has its own flag state and overrides.',
    icon: '🌍',
  },
  {
    title: 'Python SDK',
    description: 'Integrate in minutes with our first-class Python client. Type-safe, async support, and local caching.',
    icon: 'python',
  },
  {
    title: 'No redeploys',
    description: 'Control feature behavior at runtime. Fix issues or kill switches without touching your pipeline.',
    icon: '⚡',
  },
];
---

<section id="features" class="py-16 sm:py-20 md:py-28 bg-zinc-50/50 dark:bg-zinc-900/30">
  <div class="mx-auto max-w-6xl w-full px-4 sm:px-6 lg:px-8 xl:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-16">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400">Features</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
        Built for how you ship
      </h2>
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-zinc-600 dark:text-zinc-400 px-1">
        Everything you need to release confidently: toggles, rollouts, experiments, and environments without slowing down.
      </p>
    </div>
    <div class="grid gap-6 sm:gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <article class="group rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-5 sm:p-6 md:p-8 shadow-sm hover:shadow-md hover:border-brand-200 dark:hover:border-brand-800 transition-all duration-200">
          <div class="text-3xl mb-4">
            {f.icon === 'python' ? (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" class="w-9 h-9">
                <linearGradient id="py-a" x1="70.252" y1="1237.476" x2="170.659" y2="1151.089" gradientUnits="userSpaceOnUse" gradientTransform="matrix(.563 0 0 -.568 -29.215 716.163)">
                  <stop offset="0" stop-color="#5A9FD4"/>
                  <stop offset="1" stop-color="#306998"/>
                </linearGradient>
                <linearGradient id="py-b" x1="209.474" y1="1098.811" x2="173.62" y2="1149.537" gradientUnits="userSpaceOnUse" gradientTransform="matrix(.563 0 0 -.568 -29.215 716.163)">
                  <stop offset="0" stop-color="#FFD43B"/>
                  <stop offset="1" stop-color="#FFE873"/>
                </linearGradient>
                <path d="M63.391 1.988c-4.222.02-8.252.379-11.8 1.007-10.45 1.846-12.346 5.71-12.346 12.837v9.411h24.693v3.137H29.977c-7.176 0-13.46 4.313-15.426 12.521-2.268 9.405-2.368 15.275 0 25.096 1.755 7.311 5.947 12.519 13.124 12.519h8.491V67.234c0-8.151 7.051-15.34 15.426-15.34h24.665c6.866 0 12.346-5.654 12.346-12.548V15.833c0-6.693-5.646-11.72-12.346-12.837-4.244-.706-8.645-1.027-12.866-1.008zM50.037 9.557c2.55 0 4.634 2.117 4.634 4.721 0 2.593-2.083 4.69-4.634 4.69-2.56 0-4.633-2.097-4.633-4.69-.001-2.604 2.073-4.721 4.633-4.721z" fill="url(#py-a)"/>
                <path d="M91.682 28.38v10.966c0 8.5-7.208 15.655-15.426 15.655H51.591c-6.756 0-12.346 5.783-12.346 12.549v23.515c0 6.691 5.818 10.628 12.346 12.547 7.816 2.297 15.312 2.713 24.665 0 6.216-1.801 12.346-5.423 12.346-12.547v-9.412H63.938v-3.138h37.012c7.176 0 9.852-5.005 12.348-12.519 2.578-7.735 2.467-15.174 0-25.096-1.774-7.145-5.161-12.521-12.348-12.521h-9.268zM77.809 87.927c2.561 0 4.634 2.097 4.634 4.692 0 2.602-2.074 4.719-4.634 4.719-2.55 0-4.633-2.117-4.633-4.719 0-2.595 2.083-4.692 4.633-4.692z" fill="url(#py-b)"/>
              </svg>
            ) : f.icon}
          </div>
          <h3 class="text-lg font-semibold text-zinc-900 dark:text-white">{f.title}</h3>
          <p class="mt-2 text-zinc-600 dark:text-zinc-400">{f.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

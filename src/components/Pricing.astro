---
const tiers = [
  {
    name: 'Free',
    description: 'For side projects and early-stage apps.',
    price: '$0',
    period: '/month',
    cta: 'Get started free',
    href: '#',
    features: [
      'Unlimited feature flags',
      '1 project',
      '3 environments',
      'Real-time dashboard',
      'User management',
      'A/B testing',
      'Percentage rollouts',
      'Targeting rules',
      'Python SDK',
    ],
    highlighted: false,
  },
  {
    name: 'Pro',
    description: 'For growing teams that ship often.',
    price: '$4.99',
    period: '/month',
    cta: 'Get started',
    href: '#',
    features: [
      'Everything in Free',
      '3 projects',
      '5 environments',
    ],
    highlighted: true,
  },
  {
    name: 'Enterprise',
    description: 'For scale and custom needs.',
    price: '$9.99',
    period: '/month',
    cta: 'Get started',
    href: '#',
    features: [
      'Everything in Pro',
      'Unlimited projects',
      'Unlimited environments',
    ],
    highlighted: false,
  },
];
---

<section id="pricing" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-3 lg:gap-6">
      {tiers.map((tier) => (
        <article class={`relative flex flex-col rounded-2xl border p-8 sm:p-10 ${
          tier.highlighted
            ? 'border-brand-500 bg-brand-50/50 dark:bg-zinc-800 dark:border-brand-400 shadow-xl shadow-brand-500/10 z-10 scale-[1.02]'
            : 'border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900'
        }`}>
          {tier.highlighted && (
            <p class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-brand-500 dark:bg-brand-400 px-3 py-1 text-xs font-semibold text-white dark:text-zinc-900 ring-2 ring-white dark:ring-zinc-950 whitespace-nowrap">
              Most popular
            </p>
          )}
          <h3 class="text-lg font-semibold text-zinc-900 dark:text-white">{tier.name}</h3>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{tier.description}</p>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-3xl font-bold text-zinc-900 dark:text-white">{tier.price}</span>
            {tier.period && <span class="text-zinc-500 dark:text-zinc-400">{tier.period}</span>}
          </div>
          <a
            href={tier.href}
            class={`mt-6 inline-flex justify-center rounded-xl px-4 py-3 text-sm font-semibold transition-colors ${
              tier.highlighted
                ? 'bg-brand-600 text-white hover:bg-brand-700 dark:bg-brand-500 dark:hover:bg-brand-400'
                : 'bg-zinc-900 text-white hover:bg-zinc-800 dark:bg-zinc-700 dark:hover:bg-zinc-600'
            }`}
          >
            {tier.cta}
          </a>
          <ul class="mt-8 space-y-3 flex-1">
            {tier.features.map((f) => (
              <li class="flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-300">
                <span class="text-brand-500 dark:text-brand-400">✓</span> {f}
              </li>
            ))}
          </ul>
          <p class="mt-6 text-xs text-zinc-400 dark:text-zinc-500">
            Environment limits apply per project.
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Pricing from '../components/Pricing.astro';
---

<Layout title="Pricing - Flagswitch" description="Simple, transparent pricing for feature flags. Start free.">
  <Header />
  <main class="pt-14 sm:pt-16">
    <div class="mx-auto max-w-2xl px-4 text-center pt-16 sm:pt-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400">Pricing</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
        Simple, transparent pricing
      </h1>
      <p class="mt-4 text-base sm:text-lg text-zinc-600 dark:text-zinc-400">
        Get started for free. No credit card required.
      </p>
    </div>
    <Pricing />
  </main>
  <Footer />
</Layout>
